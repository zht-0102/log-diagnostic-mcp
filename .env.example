# Example environment file for log-diagnostic-mcp.
#
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# Path to the SSH private key used for production log servers
SSH_PRIVATE_KEY=/home/you/.ssh/id_ed25519

# Path to the SSH private key used for staging log servers
SSH_PRIVATE_KEY_STAGING=/home/you/.ssh/id_ed25519_staging

# Optional: override the config file location (default: config/servers.yaml)
# LOG_MCP_CONFIG=/absolute/path/to/servers.yaml
